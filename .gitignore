# Import staging — never committed
raw/

# Machine wiring, no secrets
_local/

# NDA / PII — its own rule
.confluence-private/

# Personal per-machine Claude Code overrides
.claude/settings.local.json

# Skill symlinks generated by `npx skills add` — machine-absolute paths, and git
# stores them as duplicate directories rather than links. The real files live in
# Portable skills live in .agents/skills/ and are installed to ~/.claude/skills/
# by scripts/install_skills.py, so nothing here is a link to regenerate.
# .claude/skills/ now holds only vault-bound skills, which are committed.
# Every vault-bound skill directory is committed, not just the first one: an
# allowlist naming vault-rag alone silently dropped install-vault from the clone
# it exists to install. Loose files here stay ignored.
.claude/skills/*
!.claude/skills/*/

# Obsidian's per-person interface state. Which panes were open and where the
# graph was zoomed to are facts about one person's screen, not about the vault,
# and they change on every session. The shared Obsidian configuration -- app,
# appearance, plugins, templates, types -- stays committed.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Python bytecode from scripts/
__pycache__/
*.pyc

# Bulk assets from the OneDrive migration - tens of GB, kept local only
assets/

# Subagent-driven-development scratch: ledger, task briefs, review packages.
# Working notes for an in-flight plan, not vault knowledge.
.superpowers/

# The presentation template ships two logos. The blanket assets/ rule above is
# for the bulk OneDrive migration; this folder is source, not migrated output.
!_ai/templates/presentation/assets/
